# FocusPath server configuration
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Instagram API with Instagram Login (Meta App Dashboard)
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
# Must exactly match the OAuth redirect URI configured in Meta App Dashboard.
INSTAGRAM_REDIRECT_URI=https://your-api.example.com/auth/instagram/callback
# Generate with: openssl rand -base64 32
# Keep this stable. Changing it makes already-encrypted connections unreadable.
INSTAGRAM_TOKEN_ENCRYPTION_KEY=base64_encoded_32_byte_key
# Used by the server to return to the mobile or web client after OAuth.
# The current native app scheme is manusfocuspath://. Set an HTTPS URL for a web deployment.
EXPO_PUBLIC_APP_URL=manusfocuspath://
# Optional; defaults to v26.0.
INSTAGRAM_GRAPH_VERSION=v26.0

# Send this in the x-instagram-scheduler-secret header when invoking the daily refresh route.
# Generate with: openssl rand -hex 32
INSTAGRAM_SCHEDULER_SECRET=long_random_scheduler_secret
